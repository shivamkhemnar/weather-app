# Copy this file to `.env` (same folder) and fill in your free keys.
# The app works WITHOUT keys (simulation fallback), but live data needs them.

# Data refresh: 4 hours professional mode (14400 sec). Use 10 for fast demo.
REFRESH_HOURS=4
# SIMULATION_INTERVAL_SEC=14400

# Get a FREE key: https://openweathermap.org/api -> Current Weather + 5-day forecast
OPENWEATHER_API_KEY=

# Get a FREE key: https://developer.tomtom.com/ -> Traffic Flow API
TOMTOM_API_KEY=

# Optimization weights
COST_WEIGHT=0.35
DELAY_WEIGHT=0.30
RISK_WEIGHT=0.25
INVENTORY_WEIGHT=0.10

# Database file location (relative to project root)
DATABASE_URL=sqlite:///./supply_chain.db
